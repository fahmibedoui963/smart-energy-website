generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Contact {
  id            Int      @id @default(autoincrement())
  nom           String
  email         String
  telephone     String
  ville         String
  typeProjet    String
  message       String?
  createdAt     DateTime @default(now())
}
